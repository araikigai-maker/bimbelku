generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   Enrollment[]
  tryoutResults TryoutResult[]
  catSessions   CatSession[]
  subscriptions Subscription[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String
  price       Int
  image       String?
  instructor  String
  lessons     Int      @default(0)
  students    Int      @default(0)
  rating      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  modules     Module[]
}

model Module {
  id        String   @id @default(cuid())
  title     String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  order     Int      @default(0)
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  content   String?
  videoUrl  String?
  order     Int      @default(0)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Tryout {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String
  duration    Int
  questionCount Int
  price       Int
  image       String?
  passingGrade Int     @default(0)
  catAvailableFrom DateTime?
  catAvailableUntil DateTime?
  catPassingGradePoints Int @default(0) // Total points passing grade (e.g. 285 for SKD)
  pgTwk         Int      @default(65)   // TWK passing grade points
  pgTiu         Int      @default(80)   // TIU passing grade points
  pgTkp         Int      @default(166)  // TKP passing grade points
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions  Question[]
  results    TryoutResult[]
  catSessions CatSession[]
}

model Question {
  id         String   @id @default(cuid())
  tryoutId   String
  tryout     Tryout   @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  question   String   @db.Text
  optionA    String
  optionB    String
  optionC    String
  optionD    String
  optionE    String?
  answer     String     @default("A")
  optionPoints String   @default("{}") // For TKP questions: '{"A":5,"B":4,"C":3,"D":2,"E":1}' as JSON string
  explanation String?   @db.Text
  order      Int      @default(0)
  questionType String   @default("regular") // regular or tkp
  subtest      String?  // TWK, TIU, TKP (for CAT CPNS categorization)

  catAnswers CatAnswer[]
}

model TryoutResult {
  id           String   @id @default(cuid())
  userId       String
  tryoutId     String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tryout       Tryout   @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  score        Int      // Percentage score (0-100)
  correct      Int      // Number of questions with max/perfect score
  wrong        Int      // Number wrong (regular) or not-perfect (TKP)
  answered     Int
  earnedPoints Int      @default(0) // Total points earned across all questions
  maxPoints    Int      @default(0) // Maximum possible points
  createdAt    DateTime @default(now())
}

model CatSession {
  id               String   @id @default(cuid())
  userId           String
  tryoutId         String
  token            String   @unique
  startedAt        DateTime @default(now())
  endedAt          DateTime?
  status           String   @default("active") // active, submitted, timeout
  remainingSeconds Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tryout   Tryout      @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  answers  CatAnswer[]
}

model CatAnswer {
  id         String   @id @default(cuid())
  sessionId  String
  questionId String
  answer     String?  // null if unanswered
  ragu       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  CatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model CatAccess {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  grantedAt DateTime @default(now())
}

// ============================================================
// MONETIZATION INFRASTRUCTURE
// ============================================================

model Plan {
  id           String   @id @default(cuid())
  slug         String   @unique // FREE, PREMIUM, ENTERPRISE
  name         String
  description  String
  price        Int      // in IDR (e.g. 99000)
  durationDays Int      @default(30) // 0 = lifetime / no expiry for FREE
  features     String   @db.Text // JSON array of feature strings
  isActive     Boolean  @default(true)
  highlighted  Boolean  @default(false) // shown as "most popular"
  order        Int      @default(0)     // display order on pricing page
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  planId      String
  status      String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startDate   DateTime  @default(now())
  endDate     DateTime? // null = no expiry (lifetime plan)
  paymentId   String?   // will be filled by Midtrans/Xendit webhook
  paymentRef  String?   // external order ID for reconciliation
  activatedBy String    @default("MANUAL") // MANUAL (admin) or PAYMENT_GATEWAY
  notes       String?   // admin notes (e.g. "promo batch pertama")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, endDate])
}
